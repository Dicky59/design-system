{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "description": "A token-driven design system built to be used by an LLM, plus a Finnish customers view built with it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicky59/design-system.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:build": "node design-system/tokens/build-tokens.mjs",
    "tokens:check": "node design-system/tokens/build-tokens.mjs --check",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "prestorybook": "npm run tokens:build",
    "prebuild-storybook": "npm run tokens:build",
    "manifest:build": "node design-system/build-manifest.mjs",
    "manifest:check": "node design-system/build-manifest.mjs --check",
    "tokens:contrast": "node design-system/tokens/check-contrast.mjs",
    "check": "npm run tokens:check && npm run manifest:check && npm run tokens:contrast",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-storybook": "^10.6.5",
    "playwright": "latest",
    "postcss": "^8.5.32",
    "storybook": "^10.6.5",
    "tailwindcss": "3.4",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4"
  }
}
