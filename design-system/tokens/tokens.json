{
  "$description": "Single source of truth for design tokens. Run `npm run tokens:build` after editing. References use {path.to.token} and resolve to CSS var() references.",
  "palette": {
    "neutral": {
      "0": "#ffffff",
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a",
      "950": "#020617"
    },
    "brand": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#508cfa",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af"
    },
    "success": { "50": "#f0fdf4", "200": "#bbf7d0", "800": "#166534", "950": "#052e16" },
    "warning": { "50": "#fffbeb", "200": "#fde68a", "800": "#92400e", "950": "#451a03" },
    "danger": { "50": "#fef2f2", "200": "#fecaca", "600": "#dc2626", "700": "#b91c1c", "800": "#991b1b", "950": "#450a0a" },
    "info": { "50": "#f0f9ff", "200": "#bae6fd", "800": "#075985", "950": "#082f49" },
    "teal": { "50": "#f0fdfa", "200": "#99f6e4", "800": "#115e59" },
    "forest": { "50": "#f2f8f3", "100": "#dcefdf", "200": "#b9ddc0", "600": "#2f7a45", "700": "#25633a", "800": "#1d4e2f" }
  },
  "color": {
    "surface": "{palette.neutral.0}",
    "surface-muted": "{palette.neutral.50}",
    "surface-sunken": "{palette.neutral.100}",
    "overlay": "rgba(15, 23, 42, 0.5)",

    "content": "{palette.neutral.900}",
    "content-muted": "{palette.neutral.600}",
    "content-inverse": "{palette.neutral.0}",
    "content-disabled": "{palette.neutral.400}",

    "border": "{palette.neutral.200}",
    "border-strong": "{palette.neutral.500}",

    "focus": "{palette.brand.600}",

    "primary": "{palette.brand.600}",
    "primary-hover": "{palette.brand.700}",
    "primary-active": "{palette.brand.800}",
    "primary-text": "{palette.neutral.0}",
    "primary-subtle": "{palette.brand.50}",
    "primary-subtle-hover": "{palette.brand.100}",
    "primary-subtle-text": "{palette.brand.800}",

    "link": "{palette.brand.600}",

    "danger-solid": "{palette.danger.600}",
    "danger-solid-hover": "{palette.danger.700}",
    "danger-solid-active": "{palette.danger.800}",
    "danger-solid-text": "{palette.neutral.0}",

    "neutral-bg": "{palette.neutral.100}",
    "neutral-text": "{palette.neutral.700}",
    "neutral-border": "{palette.neutral.200}",
    "success-bg": "{palette.success.50}",
    "success-text": "{palette.success.800}",
    "success-border": "{palette.success.200}",
    "warning-bg": "{palette.warning.50}",
    "warning-text": "{palette.warning.800}",
    "warning-border": "{palette.warning.200}",
    "danger-bg": "{palette.danger.50}",
    "danger-text": "{palette.danger.800}",
    "danger-border": "{palette.danger.200}",
    "info-bg": "{palette.info.50}",
    "info-text": "{palette.info.800}",
    "info-border": "{palette.info.200}"
  },
  "font": {
    "family": {
      "sans": "ui-sans-serif, system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "xs": { "size": "0.75rem", "lineHeight": "1rem" },
      "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "size": "1rem", "lineHeight": "1.5rem" },
      "lg": { "size": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "size": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "size": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "size": "1.875rem", "lineHeight": "2.25rem" }
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "space": {
    "0": "0",
    "px": "1px",
    "0.5": "0.125rem",
    "1": "0.25rem",
    "1.5": "0.375rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(15, 23, 42, 0.06)",
    "md": "0 4px 6px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -2px rgba(15, 23, 42, 0.06)",
    "lg": "0 10px 15px -3px rgba(15, 23, 42, 0.1), 0 4px 6px -4px rgba(15, 23, 42, 0.06)"
  },
  "zIndex": {
    "base": "0",
    "sticky": "1100",
    "overlay": "1200",
    "modal": "1300",
    "popover": "1400",
    "toast": "1500"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "$themes": "Themes override semantic tokens only (color.*, radius.*, font.family.*); palettes stay shared. The base color/radius/font values above are the `default` theme. See CLAUDE.md for how to add a theme.",
  "themes": {
    "default": { "label": "Oletus", "scheme": "light" },
    "forest": {
      "label": "Metsä",
      "scheme": "light",
      "color": {
        "focus": "{palette.forest.600}",
        "primary": "{palette.forest.600}",
        "primary-hover": "{palette.forest.700}",
        "primary-active": "{palette.forest.800}",
        "primary-subtle": "{palette.forest.50}",
        "primary-subtle-hover": "{palette.forest.100}",
        "primary-subtle-text": "{palette.forest.800}",
        "link": "{palette.forest.600}",
        "success-bg": "{palette.teal.50}",
        "success-text": "{palette.teal.800}",
        "success-border": "{palette.teal.200}"
      },
      "radius": {
        "sm": "0.125rem",
        "md": "0.1875rem",
        "lg": "0.25rem",
        "xl": "0.375rem"
      }
    },
    "dark": {
      "label": "Tumma",
      "scheme": "dark",
      "color": {
        "surface": "{palette.neutral.900}",
        "surface-muted": "{palette.neutral.800}",
        "surface-sunken": "{palette.neutral.700}",
        "overlay": "rgba(2, 6, 23, 0.7)",

        "content": "{palette.neutral.50}",
        "content-muted": "{palette.neutral.300}",
        "content-inverse": "{palette.neutral.900}",
        "content-disabled": "{palette.neutral.500}",

        "border": "{palette.neutral.700}",
        "border-strong": "{palette.neutral.400}",

        "focus": "{palette.brand.400}",

        "primary": "{palette.brand.400}",
        "primary-hover": "{palette.brand.300}",
        "primary-active": "{palette.brand.200}",
        "primary-text": "{palette.neutral.950}",
        "primary-subtle": "{palette.brand.800}",
        "primary-subtle-hover": "{palette.brand.700}",
        "primary-subtle-text": "{palette.brand.200}",
        "link": "{palette.brand.500}",

        "neutral-bg": "{palette.neutral.800}",
        "neutral-text": "{palette.neutral.200}",
        "neutral-border": "{palette.neutral.700}",
        "success-bg": "{palette.success.950}",
        "success-text": "{palette.success.200}",
        "success-border": "{palette.success.800}",
        "warning-bg": "{palette.warning.950}",
        "warning-text": "{palette.warning.200}",
        "warning-border": "{palette.warning.800}",
        "danger-bg": "{palette.danger.950}",
        "danger-text": "{palette.danger.200}",
        "danger-border": "{palette.danger.800}",
        "info-bg": "{palette.info.950}",
        "info-text": "{palette.info.200}",
        "info-border": "{palette.info.800}"
      }
    }
  }
}
